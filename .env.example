# ===== everyMail 配置 =====

# ============================================================
# ▼▼▼ 通用配置 ▼▼▼
# ============================================================

# 监听地址（默认 0.0.0.0 监听所有接口）
HOST=0.0.0.0

# 代理服务器监听端口
PORT=3100

# 邮件后端适配器: cloudflare_temp_email | cloudmail | shiromail | inbucket | mailpit | moemail | outlookemailplus | 2925 | smtp_imap
# 默认 cloudflare_temp_email；切换前请先配置对应后端的 URL。
MAIL_BACKEND=cloudflare_temp_email

# 启用的前端格式（逗号分隔）: shiromail | cloudflare | inbucket | mailpit | moemail | cloudmail | outlookemailplus
# 每种格式暴露对应项目的原生 API，路由到上面配置的后端。
# 默认启用 shiromail + cloudflare。
# 设为 "all" 可同时启用全部入口。
ENABLED_FRONTENDS=shiromail,cloudflare

# 本地 JWT 签名密钥（用于 everyMail 自身签发的 token）
JWT_SECRET=change-me-to-a-random-string

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# CORS 允许的 origin（默认 * 允许所有来源）
# 生产环境建议设为具体域名，如 https://your-frontend.example.com
CORS_ORIGIN=*

# ============================================================
# ▼▼▼ ShiroMail 前端格式配置（客户端连接 /shiromail 路由时使用） ▼▼▼
# ============================================================

# ShiroMail API Key
# ShiroMail 客户端连接本代理时需要提供的 API Key
# 客户端在请求头中使用: X-API-Key: <此值>
# 留空则不要求 API Key 认证（公开模式）
SHIROMAIL_API_KEY=

# 域名映射配置（ShiroMail Domain ID → CF 域名）
# 格式: JSON 对象, key 是 ShiroMail 的 Domain ID, value 是 CF 的域名
# 示例: {"1":"example.com", "2":"mail.example.org"}
# ShiroMail 前端传过来的 domain_id 会通过此映射找到对应的 CF 域名
DOMAIN_MAP={}

# 默认域名（当客户端不传 domain 时使用，留空则从 CF 后端自动获取第一个）
DEFAULT_DOMAIN=

# ============================================================
# ▼▼▼ cloudflare_temp_email 后端配置（当 MAIL_BACKEND=cloudflare_temp_email 时使用） ▼▼▼
# ============================================================

# cloudflare_temp_email 后端 API 地址
# 示例: https://temp-email-api.awsl.uk  或  http://localhost:8787
CF_TEMP_EMAIL_BASE_URL=https://your-cf-worker.workers.dev

# cloudflare_temp_email 访问密码（对应 CF 端的 PASSWORDS 环境变量，可选）
CF_TEMP_EMAIL_AUTH=

# ============================================================
# ▼▼▼ CloudMail 后端配置（当 MAIL_BACKEND=cloudmail 时使用） ▼▼▼
# ============================================================

# CloudMail 后端 API 地址
CLOUDMAIL_BASE_URL=

# CloudMail 后端访问凭证（如 API key/token，具体含义取决于 CloudMail 项目）
CLOUDMAIL_AUTH=

# CloudMail 前端认证 token（客户端连接 /cloudmail 路由时需要提供）
# 默认同 CLOUDMAIL_AUTH。设置此值可将前端认证与后端凭证解耦。
CLOUDMAIL_FRONTEND_AUTH=

# ============================================================
# ▼▼▼ ShiroMail 后端配置（当 MAIL_BACKEND=shiromail 时使用） ▼▼▼
# ============================================================

# ShiroMail 后端 API 地址（真实 ShiroMail 实例的 URL）
# 示例: https://shiromail.example.com
SHIROMAIL_BACKEND_URL=

# ShiroMail 后端 API Key（用于 Bearer token 认证）
SHIROMAIL_BACKEND_API_KEY=

# ============================================================
# ▼▼▼ Inbucket 后端配置（当 MAIL_BACKEND=inbucket 时使用） ▼▼▼
# ============================================================

# Inbucket REST API 地址（无需认证）
# 示例: http://localhost:9000
INBUCKET_BASE_URL=

# ============================================================
# ▼▼▼ Mailpit 后端配置（当 MAIL_BACKEND=mailpit 时使用） ▼▼▼
# ============================================================

# Mailpit API 地址
# 示例: http://localhost:8025
MAILPIT_BASE_URL=

# Mailpit Basic Auth 凭证（格式: user:pass，留空则无认证）
MAILPIT_AUTH=

# ============================================================
# ▼▼▼ moemail 后端配置（当 MAIL_BACKEND=moemail 时使用） ▼▼▼
# ============================================================

# moemail API 地址
# 示例: https://moemail.app
MOEMAIL_BASE_URL=

# moemail API Key（通过 X-API-Key 头发送）
MOEMAIL_AUTH=

# ============================================================
# ▼▼▼ OutlookEmailPlus 后端配置（当 MAIL_BACKEND=outlookemailplus 时使用） ▼▼▼
# ============================================================

# OutlookEmailPlus API 地址
# 示例: https://demo.outlookmailplus.tech
OUTLOOKEMAILPLUS_BASE_URL=

# OutlookEmailPlus External API Key（通过 X-API-Key 头发送）
OUTLOOKEMAILPLUS_AUTH=

# 邮箱池 provider 筛选：outlook | imap | custom | cloudflare_temp_mail
OUTLOOKEMAILPLUS_PROVIDER=outlook

# 邮箱池 caller_id，用于 claim-release 时匹配领取记录
OUTLOOKEMAILPLUS_CALLER_ID=everymail

# 可选 project_key；设置后使用 OutlookEmailPlus 的项目隔离/复用语义
OUTLOOKEMAILPLUS_PROJECT_KEY=

# OutlookEmailPlus 前端格式认证 key（客户端连接 /outlookemailplus 时使用）
# 默认同 OUTLOOKEMAILPLUS_AUTH；设置此值可将前端认证与后端凭证解耦。
OUTLOOKEMAILPLUS_FRONTEND_AUTH=

# ============================================================
# ▼▼▼ 2925 后端配置（当 MAIL_BACKEND=2925 时使用） ▼▼▼
# ============================================================

# 2925.com 的 Cookie（从浏览器登录后获取，必填）
# 用于获取 API token，token 过期后自动使用 cookie 刷新
# ⚠️ 安全警告：2925 是共享收件箱模型，任何知道邮箱地址的人都能读取邮件。
# 仅在受信任环境或需要前端认证保护的部署中使用此后端。
MAIL_2925_COOKIE=

# 2925.com 邮箱域名（默认 2925.com）
MAIL_2925_DOMAIN=2925.com

# ============================================================
# ▼▼▼ SMTP/IMAP 后端配置（当 MAIL_BACKEND=smtp_imap 时使用） ▼▼▼
# ============================================================

# IMAP 服务器地址
# 示例: imap.example.com
SMTP_IMAP_IMAP_HOST=

# IMAP 服务器端口
SMTP_IMAP_IMAP_PORT=993

# IMAP 是否使用隐式 TLS
SMTP_IMAP_IMAP_TLS=true

# SMTP 服务器地址（通过公开设置暴露给兼容客户端；当前后端接口不发送邮件）
SMTP_IMAP_SMTP_HOST=

# SMTP 服务器端口
SMTP_IMAP_SMTP_PORT=587

# SMTP 是否要求 STARTTLS/安全传输
SMTP_IMAP_SMTP_TLS=true

# 共享 IMAP 账号。设置后 everyMail 会用该账号读取收件箱，并按目标地址搜索邮件。
# 留空时进入按地址登录模式：客户端用邮箱地址和密码登录 IMAP。
SMTP_IMAP_USER=

# 共享 IMAP 账号密码
SMTP_IMAP_PASS=

# 要读取的 IMAP 文件夹
SMTP_IMAP_MAILBOX=INBOX
