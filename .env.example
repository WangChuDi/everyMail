# ===== everyMail 配置 =====

# ============================================================
# ▼▼▼ 通用配置 ▼▼▼
# ============================================================

# 监听地址（默认 0.0.0.0 监听所有接口）
HOST=0.0.0.0

# 代理服务器监听端口
PORT=3100

# 邮件后端适配器: cloudflare_temp_email | cloudmail | shiromail | inbucket | mailpit | moemail
# 默认 cloudflare_temp_email；切换前请先配置对应后端的 URL。
MAIL_BACKEND=cloudflare_temp_email

# 启用的前端格式（逗号分隔）: shiromail | cloudflare | inbucket | mailpit | moemail | cloudmail
# 每种格式暴露对应项目的原生 API，路由到上面配置的后端。
# 默认启用 shiromail + cloudflare。
# 设为 "all" 可同时启用全部入口。
ENABLED_FRONTENDS=shiromail,cloudflare

# 本地 JWT 签名密钥（用于 everyMail 自身签发的 token）
JWT_SECRET=change-me-to-a-random-string

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# CORS 允许的 origin（默认 * 允许所有来源）
# 生产环境建议设为具体域名，如 https://your-frontend.example.com
CORS_ORIGIN=*

# ============================================================
# ▼▼▼ ShiroMail 前端格式配置（客户端连接 /shiromail 路由时使用） ▼▼▼
# ============================================================

# ShiroMail API Key
# ShiroMail 客户端连接本代理时需要提供的 API Key
# 客户端在请求头中使用: X-API-Key: <此值>
# 留空则不要求 API Key 认证（公开模式）
SHIROMAIL_API_KEY=

# 域名映射配置（ShiroMail Domain ID → CF 域名）
# 格式: JSON 对象, key 是 ShiroMail 的 Domain ID, value 是 CF 的域名
# 示例: {"1":"example.com", "2":"mail.example.org"}
# ShiroMail 前端传过来的 domain_id 会通过此映射找到对应的 CF 域名
DOMAIN_MAP={}

# 默认域名（当客户端不传 domain 时使用，留空则从 CF 后端自动获取第一个）
DEFAULT_DOMAIN=

# ============================================================
# ▼▼▼ cloudflare_temp_email 后端配置（当 MAIL_BACKEND=cloudflare_temp_email 时使用） ▼▼▼
# ============================================================

# cloudflare_temp_email 后端 API 地址
# 示例: https://temp-email-api.awsl.uk  或  http://localhost:8787
CF_TEMP_EMAIL_BASE_URL=https://your-cf-worker.workers.dev

# cloudflare_temp_email 访问密码（对应 CF 端的 PASSWORDS 环境变量，可选）
CF_TEMP_EMAIL_AUTH=

# ============================================================
# ▼▼▼ CloudMail 后端配置（当 MAIL_BACKEND=cloudmail 时使用） ▼▼▼
# ============================================================

# CloudMail 后端 API 地址
CLOUDMAIL_BASE_URL=

# CloudMail 后端访问凭证（如 API key/token，具体含义取决于 CloudMail 项目）
CLOUDMAIL_AUTH=

# CloudMail 前端认证 token（客户端连接 /cloudmail 路由时需要提供）
# 默认同 CLOUDMAIL_AUTH。设置此值可将前端认证与后端凭证解耦。
CLOUDMAIL_FRONTEND_AUTH=

# ============================================================
# ▼▼▼ ShiroMail 后端配置（当 MAIL_BACKEND=shiromail 时使用） ▼▼▼
# ============================================================

# ShiroMail 后端 API 地址（真实 ShiroMail 实例的 URL）
# 示例: https://shiromail.example.com
SHIROMAIL_BACKEND_URL=

# ShiroMail 后端 API Key（用于 Bearer token 认证）
SHIROMAIL_BACKEND_API_KEY=

# ============================================================
# ▼▼▼ Inbucket 后端配置（当 MAIL_BACKEND=inbucket 时使用） ▼▼▼
# ============================================================

# Inbucket REST API 地址（无需认证）
# 示例: http://localhost:9000
INBUCKET_BASE_URL=

# ============================================================
# ▼▼▼ Mailpit 后端配置（当 MAIL_BACKEND=mailpit 时使用） ▼▼▼
# ============================================================

# Mailpit API 地址
# 示例: http://localhost:8025
MAILPIT_BASE_URL=

# Mailpit Basic Auth 凭证（格式: user:pass，留空则无认证）
MAILPIT_AUTH=

# ============================================================
# ▼▼▼ moemail 后端配置（当 MAIL_BACKEND=moemail 时使用） ▼▼▼
# ============================================================

# moemail API 地址
# 示例: https://moemail.app
MOEMAIL_BASE_URL=

# moemail API Key（通过 X-API-Key 头发送）
MOEMAIL_AUTH=
